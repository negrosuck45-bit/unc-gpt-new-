# Lunar first-party OAuth (server-side only; do not expose in browser code)
LUNAR_APP_URL=https://unc-gptt.vercel.app
LUNAR_AUTH_SECRET=
LUNAR_GOOGLE_CLIENT_ID=
LUNAR_GOOGLE_CLIENT_SECRET=
LUNAR_GITHUB_CLIENT_ID=
LUNAR_GITHUB_CLIENT_SECRET=
LUNAR_DISCORD_CLIENT_ID=
LUNAR_DISCORD_CLIENT_SECRET=

# Temporary server-only legacy account bridge. Retain only until every active
# legacy Clerk account has a verified Lunar provider link in lunar_auth_identities.
CLERK_SECRET_KEY=

# Supabase server integration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Assistant capabilities (server-side only; never expose these to the browser)
GROQ_API_KEY=
GROQ_API_KEYS=
MINIMAX_API_KEY=
# MiniMax-M2.1 is used for ordinary text chat. Visual and connected-tool
# requests remain on providers that support those capabilities.
MINIMAX_CHAT_MODEL=MiniMax-M2.1
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=minimax/minimax-m3
SERPAPI_KEY=
AGENT_GATEWAY_URL=
AGENT_COMPUTER_API_URL=
AGENT_COMPUTER_API_KEY=
COMPOSIO_API_KEY=
